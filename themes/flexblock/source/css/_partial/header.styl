.header-container.post .post-text {
  text-align: left
}

.header-container {
  position: relative
}

.header-content {
  position: relative
  width: 100%
  height: var(--banner-height)
  margin: auto
  display: flex
  flex-direction: column
  align-items: center
  justify-content: center
  z-index: 10
  pointer-events: none
}

.post-image {
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  z-index: -1
  background-size: cover
  background-position: center
  background-repeat: no-repeat
  z-index: auto
}
    
// post text
.post-text {
  overflow: hidden
  text-align: center
  color: var(--theme-text-light)
  padding: var(--content-large-padding)
}

// title
.title-wrap {
  font-size: var(--font-large-size)
  font-weight: bolder
  overflow: hidden
  text-overflow: ellipsis
  word-break: break-word
}

// sub title
.title-sub-wrap {
  margin-top: 1px
  font-size: 20px
}

// last time
.last-time {
  font-size: var(--font-base-size)
  margin-top: 10px
}

// 轮播图容器
.banner-slider {
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  overflow: hidden
  z-index: 0
  background-color: #000 // 避免图片切换时漏出底色
  &::after {
    content: ''
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    pointer-events: none // 关键！让鼠标能穿透黑纱去拖拽图片
    opacity: 0.4
    background-color: #394245
    background-image: linear-gradient(234deg, #394245 0%, #000 100%)
    z-index: 2 // 确保黑纱盖在图片上面，但在文字下面
  }

  .slider-track {
    display: flex
    width: 100%
    height: 100%
    transition: transform 0.6s ease-in-out // 左右滑动的动画
    user-select: none
    cursor: grab
    &:active {
      cursor: grabbing
    }

    .slide-item {
      flex: 0 0 100% // 每张图占满整个宽度
      width: 100%
      height: 100%
      background-size: cover
      background-position: center
    }
  }

  // 底部小圆点容器
  .slider-dots {
    position: absolute
    bottom: 20px
    left: 0
    width: 100%
    display: flex
    justify-content: center
    gap: 10px
    z-index: 10

    // 小圆点样式
    .dot {
      width: 10px
      height: 10px
      border-radius: 50%
      background-color: rgba(255, 255, 255, 0.4) // 半透明白色
      cursor: pointer
      transition: background-color 0.3s, transform 0.3s

      // 当前激活的圆点
      &.active {
        background-color: #fff // 纯白
        transform: scale(1.2) // 稍微放大一点
      }
    }
  }
}


