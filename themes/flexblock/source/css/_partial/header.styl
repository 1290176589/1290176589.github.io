/* ================= 全局基础设置 ================= */
.header-container {
  position: relative
}

/* ================= 高度控制核心区 ================= */
@media $mq-pc {
  .header-container:not(.post) {
    height: 100vh !important;
  }
  .header-container.post {
    height: 700px !important;
  }
}

@media $mq-mb {
  .header-container:not(.post) {
    height: calc(100vh - 60px) !important;
  }
  .header-container.post {
    height: 350px !important;
  }
}

/* ================= 首页文字绝对居中 ================= */
.header-container:not(.post) .header-content {
  position: absolute;
  top: 45% !important;
  left: 50%;
  transform: translate(-50%, -50%); 
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  pointer-events: none;
}

/* ================= 文章页/联系方式页文字固定靠左上 ================= */
.header-container.post .header-content {
  position: absolute !important; 
  top: 400px !important;      /* 距离顶部的高度，如果不够往下，就把 180px 改大 */
  left: 15% !important;       /* 距离左侧的宽度，如果和 LOGO 没对齐，调整这里 */
  transform: none !important; 
  width: auto !important;   
  display: flex;
  flex-direction: column;
  align-items: flex-start !important; 
  z-index: 10;
  pointer-events: none;
}

/* 👇 极其关键：清理掉可能把文字往下顶的巨大 margin，强制靠左 👇 */
.header-container.post .post-text {
  text-align: left !important;
  padding: 0 !important;
  margin: 0 !important; /* 强制清除外边距 */
  transform: none !important;
}

/* ================= 基础文字样式 ================= */
.post-image {
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  z-index: -1
  background-size: cover
  background-position: center
  background-repeat: no-repeat
  z-index: auto
}
    
// post text (全局基础)
.post-text {
  overflow: hidden
  text-align: center
  color: var(--theme-text-light)
  padding: var(--content-large-padding)
}

// title
.title-wrap {
  font-size: var(--font-large-size)
  font-weight: bolder
  overflow: hidden
  text-overflow: ellipsis
  word-break: break-word
}

// sub title
.title-sub-wrap {
  margin-top: 1px
  font-size: 20px
}

// last time
.last-time {
  font-size: var(--font-base-size)
  margin-top: 10px
}

// 轮播图容器
.banner-slider {
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  overflow: hidden
  z-index: 0
  background-color: #000
  &::after {
    content: ''
    position: absolute
    top: 0
    left: 0
    width: 100%
    height: 100%
    pointer-events: none
    opacity: 0.4
    background-color: #394245
    background-image: linear-gradient(234deg, #394245 0%, #000 100%)
    z-index: 2 
  }

  .slider-track {
    display: flex
    width: 100%
    height: 100%
    transition: transform 0.6s ease-in-out
    user-select: none
    cursor: grab
    &:active {
      cursor: grabbing
    }

    .slide-item {
      flex: 0 0 100%
      width: 100%
      height: 100%
      background-size: cover
      background-position: center
    }
  }

  // 底部小圆点容器
  .slider-dots {
    position: absolute
    bottom: 30px 
    left: 0
    width: 100%
    display: flex
    justify-content: center
    gap: 10px
    z-index: 10

    .dot {
      width: 10px
      height: 10px
      border-radius: 50%
      background-color: rgba(255, 255, 255, 0.4)
      cursor: pointer
      transition: background-color 0.3s, transform 0.3s

      &.active {
        background-color: #fff
        transform: scale(1.2)
      }
    }
  }
}