/*
 * 所有的卡片内容样式都在这里
 *
 * 卡片的通用样式在`mixins.styl`里
 */

// 卡片容器
.card-container {
  position: relative
  height: 100%

  .card-cover {
    position: absolute;
    top: 0
    right: 0
    bottom: 0
    left: 0
    background-repeat: no-repeat
    background-position: center
    background-size: cover

    &::after {
      content: "";
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      opacity: 0.6;
      background-image: linear-gradient(234deg, #394245 0%, #000 100%);
    }
  }

  .card-cover + .card-text {
    color: var(--theme-text-light)
  }

  .card-text {
    position: relative;
    color: var(--theme-text-primary);
    line-height: var(--font-base-lh);
    transition: color 0.3s ease;
    
    height: 100%
    display: flex
    flex-direction: column

    .card-text--title {
      font-size: var(--font-stress-size);
      font-weight: bolder;
      color: #fb7299;
    }

    .card-text--row {
      font-size: var(--font-common-size);
      margin-top: auto !important 
    }

    .last-time {
      font-size: var(--font-base-size)
      margin-top: 10px;
    }
  }
}

/* ================= 标题胶囊样式 ================= */
.title-capsule {
  display: inline-block;       
  width: fit-content;          
  padding: 4px 16px;           
  border: 1px solid #fb7299;   
  border-radius: 30px;         
  background-color: rgba(251, 114, 153, 0.15); 
  transition: all 0.3s ease;
  text-decoration: none;

  .card-text--title {
    margin: 0; 
  }

  &:hover {
    background-color: #fb7299;
    .card-text--title {
      color: #ffffff !important; 
    }
  }
}

/* ================= 底部链接胶囊样式 ================= */
.card-text--row {
  text-align: left; 
  margin-top: auto !important;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
}

.card-text--row a {
  display: inline-block;        
  width: fit-content;           
  padding: 4px 12px;           
  border: 1px solid #fb7299;   
  border-radius: 20px;         
  background-color: rgba(251, 114, 153, 0.1); 
  transition: all 0.3s ease;   
  line-height: 1.2;             
  
  &:hover {
    background-color: #fb7299;
    color: #ffffff !important;
  }
}

/* ================= 全局现代字体优化 ================= */
body, .markdown-body, .card-text, h1, h2, h3, h4, h5, h6 {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol" !important;
}
