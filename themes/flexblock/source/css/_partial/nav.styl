@keyframes showMobileNav {
  from {
    opacity: 0
    transform: translateX(70%)
  }

  to {
    opacity: 1
    transform: translateX(0)
  }
}

html.show-mobile-nav {
  overflow: hidden
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0)

  .navbar-list {
    display: flex
    animation showMobileNav 0.4s ease-out forwards
  }
}

.navbar {
  position: relative
  z-index: 2
}
    
.navbar-content {
  display: flex
  align-items: center
  justify-content: space-between
  max-width: var(--layout-max-width)
  width: 100%
  height: 100%
  margin: auto
  padding: 0 var(--layout-padding)
}

.navbar-logo {
  padding-right: 20px
  margin: 0
  flex: 0 1 auto
  color: var(--theme-text-light)
  font-size: var(--font-stress-size)
  font-weight: bolder

  a {
    display: flex
    align-items: center
    gap: 10px
    text-decoration: none
    outline: 0
  }

  img {
    display: block
    max-width: 100%
    max-height: 50px
    margin-right: 10px;
  }
}

.navbar-link {
  text-align: right
  font-size: 20px
}

.navbar-list-item {
  display: block
  text-decoration: none
  user-select: none

  a {
    display: block
    position: relative /* 👈 新增：作为胶囊的定位基准 */
    padding: 8px 16px /* 👈 新增：给文字撑开空间，不然胶囊会贴在字上 */
    font-weight: bolder
    transition: color 0.3s ease
    color: var(--theme-text-light)
    z-index: 1 /* 👈 让文字浮在胶囊上面 */

    /* 👇 新增的胶囊层 👇 */
    &::before {
      content: ""
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
      border-radius: 50px /* 胶囊的形状 */
      background-color: rgba(255, 255, 255, 0.15) /* 默认的半透明背景色 */
      z-index: -1 /* 放到文字底层 */
      
      /* 初始状态：稍微缩小、完全透明 */
      transform: scale(0.6)
      opacity: 0
      /* 过渡动画 */
      transition: transform 0.3s ease, opacity 0.3s ease
    }

    /* 👇 鼠标悬停状态 👇 */
    &:hover {
      color: #ffffff /* 鼠标悬停文字变纯白 */
      
      &::before {
        /* 胶囊变大、显现 */
        transform: scale(1)
        opacity: 1
      }
    }
  }
}
  
.navbar-btn {
  display: block
  position: relative
  width: 24px;
  height: 24px;
  cursor: pointer

  &.active {
    position: relative
    z-index: 1000

    div {
      transition: transform 0.3s ease 0.3s

      &::before {
        background-color: #ffffff
        transition: transform 0.3s ease, opacity 0.3s ease 0.3s, background-color 0.3s ease 0.3s
      }

      &:nth-child(1) {
        transform: rotate(45deg)
        
        &::before {
          transform: translateY(0)
        }
      }

      &:nth-child(2)::before {
        opacity: 0
      }

      &:nth-child(3) {
        transform: rotate(-45deg)

        &::before {
          transform: translateY(0)
        }
      }
    }
  }

  div {
    position: absolute;
    top: 0
    left: 0
    width: 100%
    height: 100%
    transform-origin: center
    transition: transform 0.3s ease;
    
    &:before {
      position: absolute
      content: ""
      left: 0
      right: 0
      top: 0
      bottom: 0
      margin: auto
      width: 100%
      height: 2px
      border-radius: 2px
      background-color: #ffffff
      transition: transform 0.3s ease 0.3s, opacity 0.3s ease 0.3s, background-color 0.3s ease
    }

    &:nth-child(1):before {
      transform: translateY(-8px)
    }

    &:nth-child(3):before {
      transform: translateY(8px)
    }
  }
}

@media $mq-pc {
  .navbar {
    height: 100px
  }

  .navbar-list {
    display: flex
    justify-content: flex-end
    gap: 20px
  }

  .navbar-btn {
    display: none;
  }
}

@media $mq-mb {
  .navbar {
    /*  1. 把高度改大，让上下有空间 */
    height: 60px 
  }

  /*  2. 把导航栏里的内容往下压一点，不那么贴顶  */
  .navbar-content {
    padding-top: 10px 
  }

  .navbar-btn {
    display: inline-block
    margin-top: 5px /* 汉堡按钮稍微往下移一点点 */
  }

  .navbar-list {
    display: none
    position: fixed
    flex-direction: column
    align-items: center
    justify-content: center
    gap: 20px
    /*  3. 把下拉菜单的起点改到 70px，刚好在 60px 高的导航栏下方  */
    top: 70px             
    right: 15px           
    left: auto            
    width: 180px          
    height: auto          
    max-height: 80vh      
    padding: 20px 0
    background-color: #f7f7f7
    border-radius: 10px   
    box-shadow: 0 5px 20px rgba(0,0,0,0.15) 
    z-index: 999
  }

  .navbar-list-item a {
    color: #161b3d
  }
}

/* ================= 滚动时的悬浮导航栏样式 ================= */
.navbar {
  transition: all 0.4s ease; /* 平滑过渡动画 */
}

.navbar.scrolled {
  position: fixed !important;
  top: 15px;
  left: 5%;
  width: 90%;
  height: 60px !important; 
  
  /* 👇 核心改动 1：把背景变得更透明，配合毛玻璃效果 👇 */
  background-color: rgba(255, 255, 255, 0.4) !important; /* 0.4 是透明度，越低越透，你可以调成 0.3 */
  backdrop-filter: blur(12px) !important; /* 毛玻璃模糊效果，数字越大越模糊 */
  -webkit-backdrop-filter: blur(12px) !important; /* 兼容 Safari */
  
  border-radius: 50px; 
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15); 
  z-index: 9999;
  
  /* 👇 核心改动 2：确保文字变深色，但不再强制反转 LOGO 的颜色 👇 */
  .navbar-logo, .navbar-list-item a {
    color: #333 !important; /* 文字变深色 */
    text-shadow: none;
  }
  
  /* 删除了原本这里的 filter: invert(1)，所以 LOGO 会保持原样 */

  /* 手机端汉堡按钮线条变深 */
  .navbar-btn div::before {
    background-color: #333 !important;
  }

  .navbar-content {
    padding: 0 30px;
  }
}