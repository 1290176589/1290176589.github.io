<!-- post list container -->
<div class="body-container">
  <div class="content-container layout-block article-list">
    <% page.posts.each(function(post, i) { %>
      <div class="article-item layout-padding">
        <article class="card-container article-card content-padding--large soft-size--large soft-style--box">
          <% if (post.cover) { %>
            <div class="card-cover" background-image-lazy data-img="<%- url_for(post.cover) %>"></div>
          <% } %>

          <div class="card-text">
            <!-- 👇 加上了 class="title-capsule" 👇 -->
            <% if (post.link) { %>
              <a href="<%- url_for(post.link) %>" class="title-capsule" itemprop="url" target="_blank">
                <h2 class="card-text--title"><%= post.title || "(no title)" %></h2>
              </a>
            <% } else { %>
              <a href="<%- url_for(post.path) %>" class="title-capsule" itemprop="url">
                <h2 class="card-text--title"><%= post.title || "(no title)" %></h2>
              </a>
            <% } %>

            <!-- 显示描述和视频链接 -->
            <% if (post.desc) { %>
              <p class="card-text--desc" style="font-size: 18px;  margin-top: 10px;"><%= post.desc %></p>
            <% } %>

            <!-- 底部链接组 -->
            <% if (post.Materials_link || post.video_link) { %>
              <!-- 👇 去掉了 display: flex，让链接只包裹文字 👇 -->
              <div class="card-text--row" style="text-align: left; margin-top: auto !important;">
                
                <!-- 资料链接 -->
                <% if (post.Materials_link) { %>
                  <a href="<%= post.Materials_link %>" target="_blank" style="color: #fb7299; font-weight: bold; text-decoration: none; margin-bottom: 8px; margin-right: 8px;">
                    ▶ 项目文件
                  </a>
                <% } %>

                <!-- 视频链接 -->
                <% if (post.video_link) { %>
                  <a href="<%= post.video_link %>" target="_blank" style="color: #fb7299; font-weight: bold; text-decoration: none; margin-bottom: 8px; margin-right: 8px;">
                    ▶ 预览视频
                  </a>
                <% } %>
                
              </div>
            <% } %>

            <%- partial("../_widget/category", { page: post, class_name: post.cover ? 'dark' : 'light' }) %>
            <%- partial("../_widget/tag", { page: post, class_name: post.cover ? 'dark' : 'light' }) %>
          </div>
        </article>
      </div>
    <% }) %>

    <!-- 👇 专属定制：填补单数空缺的引流卡片（自带悬浮效果） 👇 -->
    <div class="article-item layout-padding">
      <a href="/contact/" style="text-decoration: none; display: block; height: 100%; transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 16px;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.4)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
        <article class="card-container article-card content-padding--large soft-size--large soft-style--box" style="background: linear-gradient(135deg, rgba(251, 114, 153, 0.2) 0%, rgba(30, 36, 40, 0.9) 100%); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; border: 1px dashed rgba(251, 114, 153, 0.5); height: 100%;">
          
          <h2 class="card-text--title" style="color: #fff; font-size: 24px; margin-bottom: 15px;">🎁 还没有找到合适的课程？</h2>
          
          <p style="color: #adbac7; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
            想要获取全套高清教程、项目工程文件，或者需要一对一远程指导？随时联系我！
          </p>
          
          <span style="display: inline-block; padding: 10px 24px; background-color: #fb7299; color: #fff; border-radius: 50px; font-weight: bold; font-size: 16px; box-shadow: 0 4px 12px rgba(251, 114, 153, 0.3);">
            联系我获取全套课程
          </span>
          
        </article>
      </a>
    </div>
  </div>
</div>